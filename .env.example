# Copy to .env and change the API key before running:  copy .env.example .env  (Windows)
# The key must be at least 16 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DOCINTEL_API_KEY=change-me-to-a-long-random-string

# Language model: "ollama" (real model on the host GPU) or "mock" (no GPU, for demos and tests)
DOCINTEL_LLM_PROVIDER=ollama
DOCINTEL_LLM_MODEL=qwen3:8b
DOCINTEL_EMBED_MODEL=nomic-embed-text
# Ollama runs on Windows outside Docker; containers reach it through this name
DOCINTEL_OLLAMA_URL=http://host.docker.internal:11434

# Number of OCR processes; Ryzen 5 5500 has 6 cores
OCR_CONCURRENCY=5

POSTGRES_PASSWORD=docintel
